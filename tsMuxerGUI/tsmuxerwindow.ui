      <widget class="QWidget" name="tab_4">
       <attribute name="title">
        <string>Subtitles</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_9">
        <property name="margin">
         <number>5</number>
        </property>
        <item>
         <widget class="QCheckBox" name="keepTextCheckBox">
          <property name="toolTip">
           <string>Copy each SRT subtitle as text, with its tags and times, instead of drawing it into pictures. Matroska keeps it as a text track and Demux writes an SRT file. The other outputs cannot carry text subtitles and always draw them. The font and position settings below do not apply to text.</string>
          </property>
          <property name="text">
           <string>Keep SRT subtitles as text (Matroska and Demux)</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="saveSrtCheckBox">
          <property name="toolTip">
           <string>While SRT subtitles are drawn into pictures, also write each SRT track as text, to an .srt file named after the output and the track's row in the list.</string>
          </property>
          <property name="text">
           <string>Also save drawn SRT subtitles as .srt files</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="textStAsSrtCheckBox">
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="toolTip">
           <string>Blu-ray text subtitles go into a Matroska file as SRT, which every player reads. Without this tick they stay TextST, which many players do not read.</string>
          </property>
          <property name="text">
           <string>Convert Blu-ray text subtitles (TextST) to SRT</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="assAsSrtCheckBox">
          <property name="toolTip">
           <string>ASS and SSA subtitles from a Matroska file are drawn with libass, as their script says: with their styles, colours, positions and animations, and with the fonts attached to the file. Tick this to draw them as plain text with the font settings below instead.</string>
          </property>
          <property name="text">
           <string>Draw ASS and SSA subtitles as plain text, without their styles</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="fontsDirLayout">
          <item>
           <widget class="QLabel" name="fontsDirLabel">
            <property name="text">
             <string>Fonts folder for ASS and SSA subtitles:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="fontsDirLineEdit">
            <property name="toolTip">
             <string>A folder of fonts that ASS and SSA subtitles may use, besides the fonts attached to the file and the fonts installed on this computer. Leave it empty for none.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="fontsDirBrowseButton">
            <property name="text">
             <string>Browse</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
